{
  "realm": "credit-rotativo",
  "enabled": true,
  "accessTokenLifespan": 900,
  "displayName": "Crédito Rotativo",
  "loginTheme": "credit-flow",
  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR"],
  "defaultLocale": "pt-BR",
  "roles": {
    "realm": [
      { "name": "credit:write", "description": "Criar avaliações de crédito" },
      { "name": "credit:read", "description": "Consultar avaliações de crédito" },
      { "name": "credit:report", "description": "Gerar relatórios de crédito" },
      { "name": "credit:admin", "description": "Executar operações administrativas" }
    ]
  },
  "clients": [
    {
      "clientId": "credit-api",
      "name": "Credit API",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "credit-local",
      "name": "Credit local client",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "credit-bff",
      "name": "Credit browser BFF",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:${APP_PORT}/login/oauth2/code/*"],
      "webOrigins": ["http://localhost:${APP_PORT}"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm roles in ID token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "credit-observability",
      "name": "Credit observability collector",
      "enabled": true,
      "publicClient": false,
      "secret": "${PROMETHEUS_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "credit-writer",
      "firstName": "Credit",
      "lastName": "Writer",
      "email": "credit-writer@example.invalid",
      "emailVerified": true,
      "enabled": true,
      "realmRoles": ["credit:write", "credit:read", "credit:report"],
      "credentials": [{ "type": "password", "value": "${CREDIT_DEMO_PASSWORD}", "temporary": false }]
    },
    {
      "username": "credit-reader",
      "firstName": "Credit",
      "lastName": "Reader",
      "email": "credit-reader@example.invalid",
      "emailVerified": true,
      "enabled": true,
      "realmRoles": ["credit:read"],
      "credentials": [{ "type": "password", "value": "${CREDIT_DEMO_PASSWORD}", "temporary": false }]
    },
    {
      "username": "credit-reporter",
      "firstName": "Credit",
      "lastName": "Reporter",
      "email": "credit-reporter@example.invalid",
      "emailVerified": true,
      "enabled": true,
      "realmRoles": ["credit:report"],
      "credentials": [{ "type": "password", "value": "${CREDIT_DEMO_PASSWORD}", "temporary": false }]
    },
    {
      "username": "credit-admin",
      "firstName": "Credit",
      "lastName": "Admin",
      "email": "credit-admin@example.invalid",
      "emailVerified": true,
      "enabled": true,
      "realmRoles": ["credit:admin"],
      "credentials": [{ "type": "password", "value": "${CREDIT_DEMO_PASSWORD}", "temporary": false }]
    },
    {
      "username": "service-account-credit-observability",
      "enabled": true,
      "serviceAccountClientId": "credit-observability",
      "realmRoles": ["credit:admin"]
    }
  ]
}
