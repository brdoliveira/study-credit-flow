# Copy this file to .env and replace the local-only placeholders before starting.
APP_PORT=8080
APP_MAX_THREADS=400
# Identidade adicionada a cada log JSON estruturado. Não coloque segredos aqui.
APP_VERSION=local
APP_ENVIRONMENT=local
POSTGRES_PORT=5432
POSTGRES_DB=credit_rotativo
POSTGRES_USER=credit_app
POSTGRES_PASSWORD=replace-with-a-local-password
DB_MAX_POOL_SIZE=40
DB_MIN_IDLE=10
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-password
CREDIT_DEMO_PASSWORD=replace-with-a-local-demo-password
KAFKA_PORT=9092
CREDIT_REPORT_MAXIMUM_ROWS=10000
CREDIT_OUTBOX_MAXIMUM_ATTEMPTS=10
# Credenciais locais exclusivas da pilha opcional de observabilidade.
PROMETHEUS_CLIENT_SECRET=replace-with-a-local-observability-secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-password
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
TEMPO_PORT=3200
