{
  "testCommand": "gradlew.bat test --no-daemon && node --test --test-reporter=tap \"test/*.test.mjs\" \"src/test/resources/performance/*.test.js\" \"src/main/resources/static/ts/*.ts\" && node scripts/junit-to-tap.mjs",
  "reporter": "tap",
  "testGlobs": [
    "src/test/**/*.kt",
    "src/test/**/*.js",
    "src/main/resources/static/ts/**/*.ts",
    "test/**/*.mjs"
  ],
  "srcGlobs": [
    "src/main/kotlin/**",
    "src/main/resources/**"
  ]
}
